# Vai para $REMOTE_DIR/.env NO SERVIDOR. Nunca comitar, nunca sair do servidor.
#
#   scp deploy/.env.producao.example mamao@vps:/opt/mamao/.env
#   ssh mamao@vps 'chmod 600 /opt/mamao/.env && vi /opt/mamao/.env'

# Postgres — o dono das tabelas, quem roda as migrations.
POSTGRES_USER=mamao_owner
POSTGRES_PASSWORD=troque-por-algo-longo-e-aleatorio

# Conexao usada por API e Worker.
#
# Quando a RLS for ligada (Marco 1), troque para o usuario mamao_app, que NAO tem
# BYPASSRLS — e o que faz a policy valer de verdade. Ver docs/adr/0003-multi-tenancy.md.
DB_CONNECTION=Host=postgres;Database=mamao;Username=mamao_owner;Password=troque-por-algo-longo-e-aleatorio

# Chave de assinatura do JWT. Minimo 32 bytes.
#   openssl rand -base64 48
JWT_SIGNING_KEY=troque-isto-agora-com-openssl-rand-base64-48

# Origem publica, usada no CORS.
PUBLIC_ORIGIN=https://app.mamao.tech
PUBLIC_HOST=app.mamao.tech

# Coletor OTLP. Vazio desliga a exportacao.
# Nao suba stack de observabilidade no mesmo VPS: o consumo compete com o produto.
OTEL_ENDPOINT=

# ── backup (deploy/backup.sh) ─────────────────────────────────────────────────
BACKUP_PASSPHRASE=troque-por-uma-frase-longa
BACKUP_REMOTE=b2:mamao-backups          # destino do rclone, FORA do VPS
