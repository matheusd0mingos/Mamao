# Vai para $REMOTE_DIR/.env NO SERVIDOR. Nunca comitar, nunca sair do servidor.
#
#   scp deploy/.env.producao.example mamao@vps:/opt/mamao/.env
#   ssh mamao@vps 'chmod 600 /opt/mamao/.env && vi /opt/mamao/.env'

# Postgres — o dono das tabelas, quem roda as migrations.
POSTGRES_USER=mamao_owner
POSTGRES_PASSWORD=troque-por-algo-longo-e-aleatorio

# Senha do role da aplicacao. O Worker cria/atualiza o role a cada startup.
APP_ROLE_PASSWORD=troque-por-algo-longo-e-aleatorio

# Duas conexoes, de proposito:
#
#   OWNER -> Worker. Aplica migrations, cria o role e concede acesso.
#   APP   -> API. Role SEM BYPASSRLS; e isso que faz a Row-Level Security valer.
#
# Apontar a API para o owner desliga a camada 3 do isolamento em silencio.
# Ver docs/adr/0003-multi-tenancy.md.
DB_CONNECTION_OWNER=Host=postgres;Database=mamao;Username=mamao_owner;Password=troque-por-algo-longo-e-aleatorio
DB_CONNECTION_APP=Host=postgres;Database=mamao;Username=mamao_app;Password=troque-por-algo-longo-e-aleatorio

# Chave de assinatura do JWT. Minimo 32 bytes.
#   openssl rand -base64 48
JWT_SIGNING_KEY=troque-isto-agora-com-openssl-rand-base64-48

# Origem publica, usada no CORS.
PUBLIC_ORIGIN=https://app.mamao.tech
PUBLIC_HOST=app.mamao.tech

# ── e-mail (SMTP) ─────────────────────────────────────────────────────────────
# Sem isto a recuperacao de senha nao funciona: quem esquecer a senha fica sem
# acesso. A aplicacao sobe assim mesmo, mas grava um log CRITICAL no startup.
#
# Use um provedor transacional (Resend, Postmark, SendGrid, Amazon SES) e nao o
# SMTP do seu e-mail pessoal: entrega e reputacao de dominio sao o problema real.
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=nao-responda@mamao.tech
SMTP_FROM_NAME=Mamao
SMTP_REPLY_TO=

# Coletor OTLP. Vazio desliga a exportacao.
# Nao suba stack de observabilidade no mesmo VPS: o consumo compete com o produto.
OTEL_ENDPOINT=

# ── backup (deploy/backup.sh) ─────────────────────────────────────────────────
BACKUP_PASSPHRASE=troque-por-uma-frase-longa
BACKUP_REMOTE=b2:mamao-backups          # destino do rclone, FORA do VPS
