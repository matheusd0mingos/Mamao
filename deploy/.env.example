# Copie para deploy/.env (nao versionado) e preencha.
#
# Este arquivo fica na SUA maquina e configura para onde o deploy aponta.
# Os SEGREDOS DE PRODUCAO (senha do banco, chave do JWT) moram em outro .env, no
# servidor, dentro de REMOTE_DIR — nunca saem de la e nunca passam por aqui.

# ── acesso ao servidor ────────────────────────────────────────────────────────
SSH_HOST=vps.exemplo.com.br
SSH_USER=mamao
SSH_PORT=22
SSH_KEY=~/.ssh/mamao_deploy          # opcional; omita para usar o agent

# Diretorio no servidor onde vive o compose, o .env de producao e o web-dist.
REMOTE_DIR=/opt/mamao

# ── registry ──────────────────────────────────────────────────────────────────
# Faca `docker login ghcr.io` antes do primeiro deploy.
REGISTRY=ghcr.io/matheusd0mingos

# ── verificacao pela borda ────────────────────────────────────────────────────
PUBLIC_ORIGIN=https://app.mamao.tech
