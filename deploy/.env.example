# Copie para deploy/.env (nao versionado) e preencha.
#
# Este arquivo fica na SUA maquina e configura para onde o deploy aponta.
# Os SEGREDOS DE PRODUCAO (senha do banco, chave do JWT) moram em outro .env, no
# servidor, dentro de REMOTE_DIR — nunca saem de la e nunca passam por aqui.

# ── acesso ao servidor ────────────────────────────────────────────────────────
SSH_HOST=vps.exemplo.com.br
SSH_USER=mamao
SSH_PORT=22
SSH_KEY=~/.ssh/mamao_deploy          # opcional; omita para usar o agent

# Diretorio no servidor onde vive o compose, o .env de producao e o web-dist.
REMOTE_DIR=/opt/mamao

# ── registry ──────────────────────────────────────────────────────────────────
# Duas credenciais diferentes, de proposito:
#
#   PUBLICAR — desta maquina: `docker login ghcr.io` com um token write:packages.
#   BAIXAR   — do servidor: o script faz o login la com um token read:packages, e
#              pergunta na primeira vez. Nao guarde esse token aqui.
#
# Um token que publica no servidor permitiria a quem entrasse nele SUBSTITUIR a imagem
# da sua propria aplicacao. Por isso o de la so le.
REGISTRY=ghcr.io/matheusd0mingos
REGISTRY_USER=matheusd0mingos

# So para ambiente sem terminal (CI). Numa maquina de trabalho, deixe vazio e responda
# quando o script perguntar — assim o token nao fica em disco.
REGISTRY_TOKEN=

# ── verificacao pela borda ────────────────────────────────────────────────────
PUBLIC_ORIGIN=https://app.mamao.tech
